{
  "name": "machcode",
  "version": "0.1.0",
  "description": "Zero-hallucination, high-speed AI code editor CLI powered by Streaming Handoff Racing on NVIDIA NIM.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "mach": "dist/bin/machcode.js",
    "machcode": "dist/bin/machcode.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/bin/machcode.js",
    "test": "tsc && node --test --test-concurrency=1 \"dist/**/*.test.js\"",
    "lint": "eslint \"src/**/*.ts\" \"bin/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\" \"bin/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"bin/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"bin/**/*.ts\"",
    "prepare": "tsc"
  },
  "keywords": [
    "ai",
    "cli",
    "code-editor",
    "nvidia-nim",
    "llm",
    "developer-tools",
    "agent"
  ],
  "author": "Gökay Karabaş",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokaykrbs/MachCode.git"
  },
  "bugs": {
    "url": "https://github.com/gokaykrbs/MachCode/issues"
  },
  "homepage": "https://github.com/gokaykrbs/MachCode#readme",
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "boxen": "^9.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "figlet": "^1.12.0",
    "gradient-string": "^3.0.0",
    "ora": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/figlet": "^1.7.0",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}
